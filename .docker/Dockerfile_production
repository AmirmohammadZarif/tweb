# Build stage
FROM node:22 AS builder

WORKDIR /app

COPY . .

RUN npm install -g pnpm

RUN pnpm install

# Stamp a fresh build number. App.build is what singleInstance.ts and
# loadState.ts compare against the stored k_build to decide "a new version
# shipped, deactivate this tab and reload". The committed .env value is only
# bumped by `node build`, which this image does not run — so without this step
# every deploy ships build 660 and already-open tabs are never told to reload.
# Pass BUILD_NUMBER for a reproducible value; it defaults to unix seconds.
ARG BUILD_NUMBER
RUN pnpm run set-build ${BUILD_NUMBER:-}

# GlitchTip ingest DSN. Vite inlines VITE_* at BUILD time, and this image builds
# in its own container — so unless the value is passed in here, the deployed
# bundle silently ships with error tracking disabled (the code no-ops on an
# empty DSN by design). Not a secret: a DSN is a public client key, meant to be
# embedded in the bundle. Empty is a valid, supported value.
ARG VITE_GLITCHTIP_DSN=""
ENV VITE_GLITCHTIP_DSN=${VITE_GLITCHTIP_DSN}

# Source-map upload. Unlike the DSN above, SENTRY_AUTH_TOKEN IS a secret — it
# is used only inside this builder stage and never reaches the final nginx
# image, and the maps it uploads are deleted from dist/ before the serve stage
# copies anything (see sourcemaps.filesToDeleteAfterUpload in vite.config.ts).
# Leave it unset and the build behaves exactly as before, minus symbolication.
# NB: this leaves the token in the builder layer's history — fine here because
# only the final stage is pushed/served, but do not COPY the builder wholesale.
ARG SENTRY_AUTH_TOKEN=""
ARG SENTRY_URL=""
ARG SENTRY_ORG=""
ARG SENTRY_PROJECT=""
ENV SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN} \
    SENTRY_URL=${SENTRY_URL} \
    SENTRY_ORG=${SENTRY_ORG} \
    SENTRY_PROJECT=${SENTRY_PROJECT}

# Raise Node's heap ceiling for the build.
#
# Node sizes its default old-space from host RAM: on the ~5.9G production box
# that lands near 2G, and `pnpm build` dies with "Ineffective mark-compacts near
# heap limit" while the HOST still has ~4.9G free. So this is a Node ceiling, not
# a machine limit — the app is ~2700 modules and build.sourcemap emits ~190 maps,
# and the Sentry plugin then rewrites every chunk + map to inject debug ids.
#
# 4096 leaves headroom on a 5.9G box that also hosts GlitchTip (~325M) and has
# ~3.9G of swap as a backstop. Raise further only alongside more RAM: this box
# has wedged (SSH banner timeout) when a build ate the machine.
ARG NODE_BUILD_HEAP_MB=4096
ENV NODE_OPTIONS=--max-old-space-size=${NODE_BUILD_HEAP_MB}

RUN pnpm build

# Merge dist/ into the served root AND prune the previous build's chunks.
# The old `cp -r dist/. public/` only did the merge half of build.js's
# onCompiled(); public/ is a tracked build-output dir, so skipping the prune
# left every historical content-hashed chunk in the deployed root forever.
RUN pnpm run collect-dist

# Serve stage
FROM nginx:stable-alpine3.20-slim

RUN apk update && apk upgrade --no-cache

# Custom server config: never heuristically cache index.html, cache
# content-hashed assets forever, and keep service-worker routes off the SPA
# fallback. See the comments in nginx.conf.
COPY .docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/public /usr/share/nginx/html
