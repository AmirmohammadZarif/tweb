# Build stage
FROM node:22 AS builder

WORKDIR /app

COPY . .

RUN npm install -g pnpm

RUN pnpm install

RUN pnpm build

# Replicate build.js onCompiled(): merge compiled dist/ on top of public/,
# which already holds the static assets (assets/, manifests, wasm, workers).
# The served root is public/, exactly as the upstream deploy expects.
RUN cp -r /app/dist/. /app/public/

# Serve stage
FROM nginx:stable-alpine3.20-slim

RUN apk update && apk upgrade --no-cache

COPY --from=builder /app/public /usr/share/nginx/html
