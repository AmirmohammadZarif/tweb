# Local-only overrides. Copied to .env.local automatically on dev-server start
# (see vite.config.ts) and git-ignored — put secrets and per-machine values here,
# never in the tracked .env.

# Self-hosted GlitchTip ingest DSN (Sentry protocol).
# Leave EMPTY to disable error tracking: without it the SDK is never loaded and
# @lib/debug/errorTracking is a no-op, which is what you want in dev.
# Get it from GlitchTip -> your project -> Settings -> Client Keys (DSN).
# The production value belongs in the deploy environment, not in this file.
VITE_GLITCHTIP_DSN=
